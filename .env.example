# Copiar a .env y completar. .env no se sube al repositorio.
# En local, docker compose usa estos valores. En Render se cargan en el servicio.

ATD_DB_PASSWORD=
ATD_USUARIO_CONSULTA=
ATD_CLAVE_CONSULTA=
ATD_USUARIO_EDITOR=
ATD_CLAVE_EDITOR=

# Opcional. Vacío: las fotos de campo quedan en la base.
ATD_DRIVE_CARPETA=
ATD_DRIVE_CREDENCIALES=
ATD_DRIVE_REFRESH_TOKEN=

# Carpeta con acr_all.geojson y zi_all.geojson, solo para la carga inicial.
# ATD_LIMITES_DIR=
